# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ebpr_os"

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
CLERK_SECRET_KEY=sk_live_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron protection (Vercel sends Authorization: Bearer <CRON_SECRET> to cron routes)
CRON_SECRET=

# Email digest (Google Workspace app password) — optional
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Slack notifications — optional
SLACK_WEBHOOK_URL=

# Local-only role switcher for manual testing. NEVER set in Vercel.
# DEV_AUTH_BYPASS=1
